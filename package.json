{
  "name": "sit-happens",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "preview": "bun run --cwd packages/web preview",
    "prepare": "bun run --cwd packages/web prepare",
    "typecheck": "bun run --cwd packages/web typecheck",
    "lint": "oxlint --disable-nested-config .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "supabase": "^2.115.0"
  }
}
